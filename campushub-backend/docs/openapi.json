{
  "openapi": "3.0.0",
  "info": {
    "title": "CampusHub API",
    "version": "1.0.0",
    "description": "University Departmental Resource & Placement Portal"
  },
  "servers": [
    { "url": "http://127.0.0.1:8000", "description": "Local dev server" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/auth/register/": { "post": { "summary": "Public registration disabled", "security": [] } },
    "/api/auth/token/": { "post": { "summary": "Login (get JWT)", "security": [] } },
    "/api/auth/token/refresh/": { "post": { "summary": "Refresh access token", "security": [] } },
    "/api/auth/me/": { "get": { "summary": "Get current user profile" }, "patch": { "summary": "Update profile (no GPA/role)" } },
    "/api/auth/me/profile-picture/": { "post": { "summary": "Upload profile picture (multipart)" } },
    "/api/auth/password/change/": { "post": { "summary": "Change password (authenticated)" } },
    "/api/auth/password/otp/request/": { "post": { "summary": "Request a generic password recovery code", "security": [] } },
    "/api/auth/password/otp/confirm/": { "post": { "summary": "Verify recovery code and reset password", "security": [] } },
    "/api/health/": { "get": { "summary": "Health check", "security": [] } },
    "/api/users/": { "get": { "summary": "List users (admin/officer)" }, "post": { "summary": "Create user (admin)" } },
    "/api/users/{id}/": { "get": { "summary": "User detail" }, "patch": { "summary": "Update user" }, "delete": { "summary": "Deactivate user" } },
    "/api/users/{id}/resend-invitation/": { "post": { "summary": "Resend account invitation (Super Admin)" } },
    "/api/lecturers/": { "get": { "summary": "List lecturers" }, "post": { "summary": "Create lecturer (admin)" } },
    "/api/lecturers/{id}/": { "get": { "summary": "Lecturer detail" }, "patch": { "summary": "Update lecturer" }, "delete": { "summary": "Deactivate lecturer" } },
    "/api/admin/stats/": { "get": { "summary": "Admin stats" } },
    "/api/admin/logs/": { "get": { "summary": "Audit logs" } },
    "/api/academics/departments/": { "get": { "summary": "List departments" }, "post": { "summary": "Create department (admin)" } },
    "/api/academics/departments/{id}/": { "get": { "summary": "Department detail" }, "patch": { "summary": "Update department" }, "delete": { "summary": "Delete department" } },
    "/api/academics/courses/": { "get": { "summary": "List courses" }, "post": { "summary": "Create course (admin)" } },
    "/api/academics/courses/{id}/": { "get": { "summary": "Course detail" }, "patch": { "summary": "Update course" }, "delete": { "summary": "Deactivate course" } },
    "/api/academics/courses/{id}/roster/": { "get": { "summary": "Course roster (lecturer/admin)" } },
    "/api/academics/enrollments/": { "get": { "summary": "My enrollments" }, "post": { "summary": "Enroll (student)" } },
    "/api/academics/enrollments/{id}/": { "delete": { "summary": "Drop enrollment" } },
    "/api/academics/periods/": { "get": { "summary": "List academic periods (filterable and paginated)" }, "post": { "summary": "Create academic period (Registrar/admin)" } },
    "/api/academics/periods/{id}/": { "get": { "summary": "Academic period detail" }, "patch": { "summary": "Update academic period (Registrar/admin)" } },
    "/api/academics/periods/{id}/set-current/": { "patch": { "summary": "Set current academic period (Registrar/admin)" } },
    "/api/academics/registrations/": { "get": { "summary": "List registrations (student self-scope or Registrar)" }, "post": { "summary": "Create registration (student self-service or Registrar)" } },
    "/api/academics/registrations/{id}/": { "get": { "summary": "Registration detail" }, "patch": { "summary": "Update registration status and details (Registrar/admin)" } },
    "/api/admissions/applications/": { "get": { "summary": "List applications (Registrar/admin)" }, "post": { "summary": "Create application (Registrar/admin)" } },
    "/api/admissions/applications/{id}/": { "get": { "summary": "Application detail" }, "patch": { "summary": "Update application and transition status (Registrar/admin)" } },
    "/api/finance/fee-structures/": { "get": { "summary": "List fee structures (Finance/admin)" }, "post": { "summary": "Create fee structure (Finance/admin)" } },
    "/api/finance/fee-structures/{id}/": { "get": { "summary": "Fee structure detail" }, "patch": { "summary": "Update fee structure (Finance/admin)" } },
    "/api/finance/invoices/": { "get": { "summary": "List invoices, scoped to student when applicable" }, "post": { "summary": "Issue invoice (Finance/admin)" } },
    "/api/finance/invoices/{id}/": { "get": { "summary": "Invoice detail" }, "patch": { "summary": "Update invoice (Finance/admin)" } },
    "/api/finance/payments/": { "get": { "summary": "List payments, scoped to student when applicable" }, "post": { "summary": "Record or reconcile payment (Finance/admin)" } },
    "/api/finance/payments/{id}/": { "get": { "summary": "Payment detail" }, "patch": { "summary": "Update pending/reconciliation payment (Finance/admin)" } },
    "/api/finance/payments/{id}/void/": { "post": { "summary": "Auditable payment reversal (Finance/admin)" } },
    "/api/finance/payment-requests/": { "get": { "summary": "List payment requests, scoped to student when applicable" }, "post": { "summary": "Request payment (student); does not confirm payment" } },
    "/api/library/books/": { "get": { "summary": "List books and derived availability" }, "post": { "summary": "Create book (Librarian/admin)" } },
    "/api/library/books/{id}/": { "get": { "summary": "Book detail" }, "patch": { "summary": "Update book (Librarian/admin)" } },
    "/api/library/loans/": { "get": { "summary": "List loans, scoped to student when applicable" }, "post": { "summary": "Issue loan (Librarian/admin)" } },
    "/api/library/loans/{id}/": { "get": { "summary": "Loan detail" }, "patch": { "summary": "Transition loan (Librarian/admin)" } },
    "/api/library/reservations/": { "get": { "summary": "List reservations, scoped to student when applicable" }, "post": { "summary": "Create reservation (student or Librarian)" } },
    "/api/library/reservations/{id}/": { "get": { "summary": "Reservation detail" }, "patch": { "summary": "Transition reservation (Librarian/admin)" } },
    "/api/hostels/": { "get": { "summary": "List hostels" }, "post": { "summary": "Create hostel (Warden/admin)" } },
    "/api/hostels/{id}/": { "get": { "summary": "Hostel detail" }, "patch": { "summary": "Update hostel (Warden/admin)" } },
    "/api/hostels/rooms/": { "get": { "summary": "List rooms and derived occupancy" }, "post": { "summary": "Create room (Warden/admin)" } },
    "/api/hostels/rooms/{id}/": { "get": { "summary": "Room detail" }, "patch": { "summary": "Update room (Warden/admin)" } },
    "/api/hostels/allocations/": { "get": { "summary": "List allocations, scoped to student when applicable" }, "post": { "summary": "Request or create allocation" } },
    "/api/hostels/allocations/{id}/": { "get": { "summary": "Allocation detail" }, "patch": { "summary": "Transition allocation (Warden/admin)" } },
    "/api/resources/courses/{course_id}/resources/": { "get": { "summary": "List resources" }, "post": { "summary": "Upload resource (lecturer/admin)" } },
    "/api/resources/courses/{course_id}/resources/{id}/": { "get": { "summary": "Resource detail" }, "patch": { "summary": "Update resource" }, "delete": { "summary": "Delete resource" } },
    "/api/resources/courses/{course_id}/resources/{id}/download/": { "get": { "summary": "Download resource" } },
    "/api/resources/courses/{course_id}/announcements/": { "get": { "summary": "List announcements" }, "post": { "summary": "Create announcement" } },
    "/api/resources/courses/{course_id}/announcements/{id}/": { "get": { "summary": "Announcement detail" }, "patch": { "summary": "Update announcement" }, "delete": { "summary": "Delete announcement" } },
    "/api/placements/": { "get": { "summary": "List placements" }, "post": { "summary": "Create placement (officer/admin)" } },
    "/api/placements/{id}/": { "get": { "summary": "Placement detail" }, "patch": { "summary": "Update placement" }, "delete": { "summary": "Deactivate placement" } },
    "/api/placements/{id}/apply/": { "post": { "summary": "Apply for placement (student)" } },
    "/api/applications/": { "get": { "summary": "List applications" } },
    "/api/applications/{id}/": { "get": { "summary": "Application detail" } },
    "/api/applications/{id}/withdraw/": { "delete": { "summary": "Withdraw application (student)" } },
    "/api/applications/{id}/status/": { "patch": { "summary": "Update application status (officer/admin)" } },
    "/api/notifications/": { "get": { "summary": "List notifications" } },
    "/api/notifications/read-all/": { "patch": { "summary": "Mark all as read" } },
    "/api/notifications/unread-count/": { "get": { "summary": "Unread count" } },
    "/api/notifications/{id}/read/": { "patch": { "summary": "Mark as read" } }
  }
}
