SECRET_KEY=your-secret-key-here
DEBUG=True
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
DB_NAME=campushub_db
DB_USER=campushub_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Required by config.settings.prod; comma-separated origins/hosts.
ALLOWED_HOSTS=campushub-backend-nbgc.onrender.com
CORS_ALLOWED_ORIGINS=https://campus-hub-monorepo.vercel.app
CSRF_TRUSTED_ORIGINS=https://campushub-backend-nbgc.onrender.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=campushub@example.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=CampusHub <campushub@example.com>
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_VISION_API_KEY=
AI_FEED_CACHE_HOURS=24
AI_AT_RISK_MIN_TRAINING_ROWS=200
# Optional only when force-seeding with DEBUG=False.
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
SEED_LECTURER_PASSWORD=
SEED_STUDENT_PASSWORD=
